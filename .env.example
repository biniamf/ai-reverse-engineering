# Copy to .env if you add dotenv loading later, or set these variables manually.

# ollama, openai, or custom
LLM_PROVIDER=ollama

# Local Ollama defaults
OLLAMA_API_BASE=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5-coder:14b

# Hosted OpenAI mode
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=your-model-name
# OPENAI_API_BASE=https://api.openai.com/v1

# Any OpenAI-compatible gateway
# LLM_PROVIDER=custom
# API_BASE=https://your-compatible-endpoint/v1
# API_KEY=your-key
# MODEL_NAME=your-model-name

GHIDRA_API_BASE=http://localhost:9090

# Docker Compose host-side ports. Internal service URLs remain unchanged.
WEBUI_PORT=5000
GHIDRA_PORT=9090
LIBRETRANSLATE_PORT=5001

# Runtime logs. In Docker Compose this is /app/logs and is mounted to ./logs.
AIREVERSE_LOG_DIR=logs
AIREVERSE_LOG_MAX_BYTES=1048576
AIREVERSE_LOG_BACKUPS=3

# Optional chat translation. Enable explicitly because Flask also uses :5000.
TRANSLATOR_PROVIDER=off

# LibreTranslate or LibreTranslate-compatible service.
# TRANSLATOR_PROVIDER=libretranslate
LIBRETRANSLATE_API_BASE=http://192.168.0.179:5000
LIBRETRANSLATE_API_KEY=

# Generic network JSON translator. Useful for your own DeepL/Google/Argos proxy.
# TRANSLATOR_PROVIDER=custom
# TRANSLATOR_API_BASE=http://translator-gateway.local:8080
# TRANSLATOR_ENDPOINT=/translate
# TRANSLATOR_TEXT_FIELD=q
# TRANSLATOR_SOURCE_FIELD=source
# TRANSLATOR_TARGET_FIELD=target
# TRANSLATOR_RESULT_FIELD=translatedText
# TRANSLATOR_AUTH_HEADER=Authorization
# TRANSLATOR_AUTH_TOKEN=Bearer your-token
# TRANSLATOR_API_KEY=

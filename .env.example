# Biniam Demissie
# Copy to .env and set the required values. Never commit a real .env.

# Required LLM configuration
API_BASE=
MODEL_NAME=

# Hosted providers require a real key; local/keyless endpoints can use not-used.
API_KEY=not-used
LLM_STREAM=auto

# Ghidra service
# Source runs use 127.0.0.1; Compose overrides this with http://ghidra:9090.
GHIDRA_API_BASE=http://127.0.0.1:9090
GHIDRA_IMAGE=biniamfd/ghidra-headless-rest:1.2.1@sha256:971591a3a8448d8ed969079b452306e806f36079c3ddd298f4a618d6e2f1442d
ANALYSIS_TIMEOUT=1800
DECOMPILE_TIMEOUT=30

# Common WebUI controls
LLM_TIMEOUT=60
MAX_UPLOAD_BYTES=104857600
MAX_CONTEXT_CHARS=100000
MAX_AGENT_TURNS=5
MAX_AUTONOMOUS_STEPS=12

# Advanced network and result bounds
CONNECT_TIMEOUT=5
READ_TIMEOUT=30
MAX_RESPONSE_BYTES=26214400
MAX_TOOL_RESULT_CHARS=20000

# Summary cache
SUMMARY_CACHE_TTL=300
SUMMARY_CACHE_MAX_ENTRIES=128

# Logging
LOG_LEVEL=INFO
LOG_FILE=
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3

# Source-run server and storage
HOST=127.0.0.1
PORT=5000
DEBUG=false
CHATS_DIR=webui/chats

# Gunicorn (container/production)
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5

# Optional static-asset release identifier; empty uses a deterministic content hash.
APP_VERSION=
